@namespace Frontend.Components.Shared

<div class="empty-container">
    <div class="empty-icon">📭</div>
    <h3>@Title</h3>
    <p>@Message</p>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Sin datos";

    [Parameter]
    public string Message { get; set; } = "No hay elementos para mostrar.";
}

<style>
    .empty-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        color: #666;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 20px;
    }

    h3 {
        margin-bottom: 10px;
        color: #333;
    }

    p {
        color: #666;
        text-align: center;
    }
</style>
