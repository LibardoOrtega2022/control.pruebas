            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="prestamos">
                <span class="icon">📤</span> Préstamos
            </NavLink>
        </div>
        
        <div class="nav-section">Analytics</div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reportes">
                <span class="icon">📊</span> Reportes
            </NavLink>
        </div>
    </nav>
